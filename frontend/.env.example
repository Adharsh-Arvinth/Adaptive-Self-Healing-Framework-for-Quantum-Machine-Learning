# Backend API URL (set this to your deployed backend URL)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# WebSocket URL for real-time telemetry (use wss:// for HTTPS deployments)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/telemetry

# Optional public manuscript URL (a https://doi.org/ URL also enables the DOI link)
NEXT_PUBLIC_PAPER_URL=

# Optional Zenodo version DOI URL for the dataset card
NEXT_PUBLIC_DATASET_ARCHIVE_URL=

# Optional author portfolio URL
NEXT_PUBLIC_PORTFOLIO_URL=
